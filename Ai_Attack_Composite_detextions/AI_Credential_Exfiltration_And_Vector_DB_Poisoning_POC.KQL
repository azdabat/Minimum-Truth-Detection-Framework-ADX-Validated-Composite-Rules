// =========================================================================
// COMPOSITE HUNT (L2/L3): AI_Credential_Exfiltration_And_Vector_DB_Poisoning
// Author: Minimum Truth Detection Framework (MTDF)
// Status: POC (Proof of Concept - ADX/MDE Validated Schema)
// Target Platform: Microsoft Defender XDR / Sentinel Advanced Hunting
// Telemetry Domain: DeviceProcessEvents
// Target MITRE ATLAS: AML.T0024 (Exfiltration of Model/Vector Assets), OWASP-LLM03 (Training Data / Vector Poisoning)
// Framework Integrity Baseline:
//   - Minimum Truth Anchor: Processes querying API keys/credentials alongside interactions with vector store files or databases.
//   - Scoring Threshold: Base=55 | Critical >= 120 | High >= 90 | Medium >= 70
// =========================================================================

let lookback = 7d;
let CredentialTargetTokens = dynamic(["openai_api_key", "anthropic_api_key", "huggingface_token", ".env", "aws_access_key_id"]);
let VectorStoreArtifacts = dynamic(["chroma.sqlite", "vector.db", "faiss", "qdrant", "milvus", ".parquet"]);
let ExfilTools = dynamic(["curl.exe", "wget.exe", "rclone.exe", "nc.exe", "powershell.exe"]);

// Minimum Truth Anchor
DeviceProcessEvents
| where Timestamp >= ago(lookback)
| extend CurrentCL = tolower(tostring(ProcessCommandLine))
| where CurrentCL has_any (CredentialTargetTokens) 
   or CurrentCL has_any (VectorStoreArtifacts)
| extend 
    IsCredentialScan  = toint(CurrentCL has_any (CredentialTargetTokens)),
    IsVectorStoreOp   = toint(CurrentCL has_any (VectorStoreArtifacts)),
    HasExfilUtility   = toint(FileName in~ (ExfilTools)),
    IsExternalExfil   = toint(CurrentCL has_any ("http://", "https://", "s3://", "blob.core.windows.net"))
| extend 
    RawScore = 55
        + (35 * (IsCredentialScan * IsExternalExfil))
        + (30 * (IsVectorStoreOp * HasExfilUtility))
        + (25 * IsCredentialScan)
        + (20 * IsVectorStoreOp)
| extend RiskScore = iif(RawScore < 0, 0, RiskScore)
| extend RiskLevel = case(
    RiskScore >= 120, "CRITICAL",
    RiskScore >= 90,  "HIGH",
    RiskScore >= 70,  "MEDIUM",
    "LOW"
)
| where RiskLevel in ("MEDIUM", "HIGH", "CRITICAL")
| extend HunterDirective = case(
    RiskScore >= 120 and IsCredentialScan == 1,
        "CRITICAL [AML.T0024]: AI API keys or environment secrets accessed and targeted for external transmission. Revoke compromised keys immediately and investigate endpoint.",
    RiskLevel >= "90" and IsVectorStoreOp == 1,
        "HIGH [OWASP-LLM03]: Vector database files or RAG indices modified or accessed alongside network exfiltration tools. High indicator of Vector Database Poisoning or context extraction.",
    "MEDIUM: Suspicious environment or database interaction by application runtime."
)
| project Timestamp, DeviceName, AccountName, FileName, ProcessCommandLine, RiskScore, RiskLevel, HunterDirective
| sort by RiskScore desc, Timestamp desc
